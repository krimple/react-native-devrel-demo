# OpenTelemetry Configuration
HONEYCOMB_API_KEY=your_honeycomb_api_key_here
OTEL_SERVICE_NAME=react-native-otel-demo
OTEL_RESOURCE_ATTRIBUTES=service.name=react-native-otel-demo,service.version=1.0.0

# API Configuration
API_BASE_URL=http://localhost:9191
ENABLE_TELEMETRY=true

# Development Settings
DEBUG_MODE=true
LOG_LEVEL=debug

# Jaeger Configuration (for local development)
JAEGER_ENDPOINT=http://localhost:14268/api/traces
JAEGER_ENABLED=true